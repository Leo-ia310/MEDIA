# ========================
# SUPABASE
# ========================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ========================
# GROQ - PRIMARY AI
# ========================
GROQ_API_KEY=
GROQ_LOW_MODEL=openai/gpt-oss-20b
GROQ_MEDIUM_MODEL=qwen/qwen3.8-27b
GROQ_HIGH_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=35

# ========================
# GEMINI - IMAGE GENERATION
# ========================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_QUALITY_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=60

# ========================
# CLOUDFLARE - FALLBACK + EMBEDDINGS
# ========================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
AI_TIMEOUT_FALLBACK_TO_LOW=true

# ========================
# RESEND
# ========================
RESEND_API_KEY=

# ========================
# BACKEND
# ========================
STRICT_DOCUMENT_GROUNDING=false
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
REQUEST_TIMEOUT_SECONDS=90
APP_ENV=development
LOG_LEVEL=INFO

# ========================
# PROJECT CONTEXT / RAG
# ========================
OBSIDIAN_RETRIEVAL_ENABLED=true
OBSIDIAN_VAULT_PATH=C:\Users\Maykel\Music\Maikel Main
