# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Models
AI_MODEL_LOW=@cf/zai-org/glm-4.7-flash
AI_MODEL_MEDIUM=@cf/qwen/qwen3.8-27b
AI_MODEL_HIGH=@cf/qwen/qwen3.8-27b
AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
AI_TIMEOUT_FALLBACK_TO_LOW=true

# RAG
STRICT_DOCUMENT_GROUNDING=false

# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=90
